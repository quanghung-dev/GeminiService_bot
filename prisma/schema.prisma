generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// CHECK constraint in PostgreSQL: "AdminAccount_singleton" CHECK (id = 1)
model AdminAccount {
  id           Int    @id @default(1)
  username     String @unique
  passwordHash String
}

model User {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  telegramId      BigInt          @unique @map("telegram_id")
  username        String?         @db.VarChar(255)
  firstName       String          @map("first_name") @db.VarChar(255)
  lastName        String?         @map("last_name") @db.VarChar(255)
  languageCode    LanguageCode?   @map("language_code")
  walletVnd       BigInt          @default(0) @map("wallet_vnd")
  walletUsdt      Decimal         @default(0) @map("wallet_usdt") @db.Decimal(24, 6)
  role            UserRole        @default(USER)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  orders          Order[]
  assignedTickets SupportTicket[] @relation("support_tickets_assigned_toTousers")
  supportTickets  SupportTicket[] @relation("support_tickets_user_idTousers")

  @@map("users")
}

model Product {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String   @db.VarChar(255)
  slug          String   @unique @db.VarChar(100)
  descriptionVi String?  @map("description_vi")
  descriptionEn String?  @map("description_en")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  image         String?
  plans         Plan[]

  @@index([isActive, sortOrder], map: "products_is_active_sort_order_idx")
  @@map("products")
}

/// CHECK constraint in PostgreSQL: "plans_stock_quantity_check" CHECK (stock_quantity >= 0)
model Plan {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  code          String   @unique @db.VarChar(100)
  nameVi        String   @map("name_vi") @db.VarChar(255)
  nameEn        String   @map("name_en") @db.VarChar(255)
  descriptionVi String?  @map("description_vi")
  descriptionEn String?  @map("description_en")
  price         BigInt
  currency      String   @default("VND") @db.VarChar(3)
  durationDays  Int      @map("duration_days")
  warrantyDays  Int      @default(0) @map("warranty_days")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  stockQuantity Int            @default(0) @map("stock_quantity")
  handleType    PlanHandleType @default(OTHER) @map("handle_type")
  handleConfig  Json           @default("{}") @map("handle_config")
  orders        Order[]
  product       Product        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("plans")
}

model Order {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderCode             String                 @unique @map("order_code") @db.VarChar(50)
  userId                String                 @map("user_id") @db.Uuid
  planId                String                 @map("plan_id") @db.Uuid
  targetEmail           String?                @map("target_email") @db.VarChar(255)
  handleType            PlanHandleType         @default(OTHER) @map("handle_type")
  totalAmount           BigInt                 @map("total_amount")
  currency              String                 @default("VND") @db.VarChar(3)
  status                OrderStatus            @default(PENDING)
  failureReason         String?                @map("failure_reason")
  paidAt                DateTime?              @map("paid_at") @db.Timestamptz(6)
  completedAt           DateTime?              @map("completed_at") @db.Timestamptz(6)
  cancelledAt           DateTime?              @map("cancelled_at") @db.Timestamptz(6)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  expiresAt             DateTime               @default(dbgenerated("(now() + '00:30:00'::interval)")) @map("expires_at") @db.Timestamptz(6)
  planSnapshot          Json                   @default("{}") @map("plan_snapshot")
  paymentProvider       PaymentProvider?       @map("payment_provider")
  paymentContent        String?                @map("payment_content") @db.VarChar(64)
  paymentQrCode         String?                @map("payment_qr_code")
  paymentQrLink         String?                @map("payment_qr_link")
  paymentVaAccount      String?                @map("payment_va_account") @db.VarChar(64)
  paymentProviderRef    String?                @map("payment_provider_ref") @db.VarChar(255)
  stockReserved         Boolean                @default(false) @map("stock_reserved")
  stockReleasedAt       DateTime?              @map("stock_released_at") @db.Timestamptz(6)
  plan                  Plan                   @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fulfillment           OrderFulfillment?
  payments              Payment[]
  subscription          Subscription?
  supportTickets        SupportTicket[]
  telegramNotifications TelegramNotification[]

  @@index([paidAt], map: "orders_paid_at_idx", where: raw("(paid_at IS NOT NULL)"))
  @@index([expiresAt], map: "orders_pending_expires_idx", where: raw("(status = 'PENDING'::order_status)"))
  @@index([userId, createdAt(sort: Desc)], map: "orders_user_created_idx")
  @@map("orders")
}

model Payment {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider              PaymentProvider
  orderId               String?                @map("order_id") @db.Uuid
  referenceCode         String?                @map("reference_code") @db.VarChar(255)
  amount                BigInt
  currency              String                 @default("VND") @db.VarChar(3)
  content               String?
  bankName              String?                @map("bank_name") @db.VarChar(100)
  status                PaymentStatus          @default(PENDING)
  failureReason         String?                @map("failure_reason")
  transactionAt         DateTime               @map("transaction_at") @db.Timestamptz(6)
  verifiedAt            DateTime?              @map("verified_at") @db.Timestamptz(6)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  providerTransactionId String?                @map("provider_transaction_id") @db.VarChar(255)
  bankAccount           String?                @map("bank_account") @db.VarChar(64)
  transType             String?                @map("trans_type") @db.VarChar(8)
  rawPayload            Json?                  @map("raw_payload")
  receivedAt            DateTime               @default(now()) @map("received_at") @db.Timestamptz(6)
  order                 Order?                 @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  telegramNotifications TelegramNotification[]

  @@unique([provider, providerTransactionId], map: "payments_provider_transaction_key")
  @@unique([orderId], map: "payments_order_verified_unique_idx", where: raw("((status = 'VERIFIED'::payment_status) AND (order_id IS NOT NULL))"))
  @@index([orderId], map: "payments_order_verified_idx", where: raw("(status = 'VERIFIED'::payment_status)"))
  @@map("payments")
}

model OrderFulfillment {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String         @unique @map("order_id") @db.Uuid
  handleType    PlanHandleType @map("handle_type")
  customerInput Json?          @map("customer_input")
  deliveryData  Json?          @map("delivery_data")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("order_fulfillments")
}

model Subscription {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String             @unique @map("order_id") @db.Uuid
  targetEmail       String?            @map("target_email") @db.VarChar(255)
  accountIdentifier String?            @map("account_identifier") @db.VarChar(255)
  status            SubscriptionStatus @default(ACTIVE)
  activatedAt       DateTime           @map("activated_at") @db.Timestamptz(6)
  expiresAt         DateTime           @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  order             Order              @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([expiresAt], map: "subscriptions_expires_at_idx", where: raw("(status = 'ACTIVE'::subscription_status)"))
  @@map("subscriptions")
}

model SupportTicket {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketCode    String         @unique @map("ticket_code") @db.VarChar(50)
  userId        String         @map("user_id") @db.Uuid
  orderId       String?        @map("order_id") @db.Uuid
  assignedTo    String?        @map("assigned_to") @db.Uuid
  subject       String         @db.VarChar(255)
  description   String
  category      TicketCategory @default(OTHER)
  status        TicketStatus   @default(OPEN)
  adminResponse String?        @map("admin_response")
  resolvedAt    DateTime?      @map("resolved_at") @db.Timestamptz(6)
  closedAt      DateTime?      @map("closed_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  assignee      User?          @relation("support_tickets_assigned_toTousers", fields: [assignedTo], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user          User           @relation("support_tickets_user_idTousers", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "support_tickets_user_created_idx")
  @@map("support_tickets")
}

/// CHECK constraints in PostgreSQL:
/// - "telegram_notifications_status_check" CHECK (status IN ('PENDING', 'PROCESSING', 'SENT', 'FAILED'))
/// - "telegram_notifications_attempts_check" CHECK (attempts >= 0)
/// - "telegram_notifications_max_attempts_check" CHECK (max_attempts > 0)
model TelegramNotification {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dedupeKey        String    @unique @map("dedupe_key") @db.VarChar(191)
  chatId           BigInt    @map("chat_id")
  notificationType String    @map("notification_type") @db.VarChar(64)
  orderId          String?   @map("order_id") @db.Uuid
  paymentId        String?   @map("payment_id") @db.Uuid
  payload          Json
  status           String    @default("PENDING") @db.VarChar(24)
  attempts         Int       @default(0)
  maxAttempts      Int       @default(10) @map("max_attempts")
  nextAttemptAt    DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lockedAt         DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy         String?   @map("locked_by") @db.VarChar(128)
  lockExpiresAt    DateTime? @map("lock_expires_at") @db.Timestamptz(6)
  lastError        String?   @map("last_error")
  sentAt           DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  order            Order?    @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment          Payment?  @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([nextAttemptAt], map: "telegram_notifications_pending_idx", where: raw("((status)::text = 'PENDING'::text)"))
  @@index([lockExpiresAt], map: "telegram_notifications_processing_lock_idx", where: raw("((status)::text = 'PROCESSING'::text)"))
  @@map("telegram_notifications")
}

enum LanguageCode {
  vi
  en

  @@map("language_code")
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED

  @@map("order_status")
}

enum PaymentProvider {
  SEPAY
  TELEGRAM_STARS
  MANUAL
  VIETQR

  @@map("payment_provider")
}

enum PaymentStatus {
  PENDING
  VERIFIED
  UNMATCHED
  REJECTED

  @@map("payment_status")
}

enum PlanHandleType {
  LINK
  CUSTOMER_ACCOUNT
  PROVIDED_ACCOUNT
  OTHER

  @@map("plan_handle_type")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED

  @@map("subscription_status")
}

enum TicketCategory {
  PAYMENT
  ACTIVATION
  OTHER

  @@map("ticket_category")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("ticket_status")
}

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}
