DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require"
PORT=3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_EMOJI_OWNER_ID=
TELEGRAM_ADMIN_CHAT_ID=

# Optional Customer Support Contacts (shown in bot Support menu when configured)
SUPPORT_TELEGRAM=
SUPPORT_ZALO=

# VietQR API Service Integration
VIETQR_ENABLED=false
VIETQR_ENV=uat
VIETQR_MERCHANT_NAME=

# Inbound Auth (VietQR -> Backend)
VIETQR_CLIENT_USERNAME=
VIETQR_CLIENT_PASSWORD=
VIETQR_TOKEN_SECRET=
VIETQR_TOKEN_EXPIRES_IN=300

# Outbound API (Backend -> VietQR)
VIETQR_BASE_URL=https://dev.vietqr.org
VIETQR_SYSTEM_USERNAME=
VIETQR_SYSTEM_PASSWORD=
VIETQR_QR_TYPE=0

# Beneficiary Bank Account (used for VietQR generation and callback reconciliation)
VIETQR_BANK_CODE=
VIETQR_BANK_ACCOUNT=
VIETQR_ACCOUNT_NAME=
VIETQR_TERMINAL_CODE=

# Order Settings
ORDER_EXPIRES_MINUTES=30
